# Copy this file to .env and fill in values, or use .env.preview / .env.preprod
# Run: vite --mode preview   (uses .env.preview)
# Run: vite --mode preprod   (uses .env.preprod)

# Midnight network to connect to: preview | preprod
VITE_NETWORK_ID=preview

# Deployed contract address (hex, 64 chars)
# Get this from .midnight-state.json after running: npm run setup -- --network preview
VITE_CONTRACT_ADDRESS=

# Indexer GraphQL endpoint
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Indexer WebSocket endpoint
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Proof server URL (Lace's public proof server or your own)
VITE_PROOF_SERVER_URL=https://lace-proof-pub.preview.midnight.network
